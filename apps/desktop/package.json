{
  "name": "@gdisc/desktop",
  "version": "1.0.4",
  "description": "GDisC - Plataforma de Comunicação em Tempo Real",
  "author": "GDisC Team",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/main', {recursive:true}); fs.copyFileSync('src/main/preload.cjs', 'dist/main/preload.cjs');\"",
    "dev": "tsx watch src/main/index.ts",
    "start": "electron ."
  },
  "dependencies": {
    "@gdisc/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "electron": "34.5.8",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
