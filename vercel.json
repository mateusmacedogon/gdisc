{
  "version": 2,
  "builds": [
    {
      "src": "apps/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/apps/client/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/client/dist/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
