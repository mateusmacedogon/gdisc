# ===================================
# GDisC Configuration Environment
# ===================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Security & Secrets
JWT_SECRET=super_secret_gdisc_jwt_key_change_me_in_production_min32chars
SESSION_SECRET=super_secret_gdisc_session_cookie_key_change_in_production

# Database (PostgreSQL or SQLite for quick local zero-config dev)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gdisc?schema=public"

# WebRTC STUN/TURN servers
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
