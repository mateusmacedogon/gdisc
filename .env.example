# ===================================
# GDisC Configuration Environment
# ===================================

# Public Supabase client configuration (safe for browser/mobile bundles)
# Never use SUPABASE_SECRET_KEY or service_role in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public web URL used when desktop/mobile clients copy invite links.
VITE_PUBLIC_APP_URL=https://gdisc-client.vercel.app

# Optional but recommended for reliable calls across mobile/corporate networks.
# These values are bundled into the client; prefer short-lived TURN credentials.
VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
VITE_TURN_USERNAME=temporary_username
VITE_TURN_CREDENTIAL=temporary_credential
# Preferred for production: HTTPS endpoint that returns temporary credentials
# as an array of RTCIceServer objects or { "iceServers": [...] }. When this is
# a protected Supabase Edge Function, the client sends the signed-in user's JWT.
VITE_TURN_CREDENTIALS_URL=https://your-project-ref.supabase.co/functions/v1/turn-credentials

# Server Configuration
PORT=4000
HOST=0.0.0.0
# NODE_ENV é omitido de propósito: o servidor assume development localmente,
# enquanto Vite/Vercel precisam definir production durante o build.
CLIENT_ORIGIN=http://localhost:5173

# Legacy Fastify server (optional local fallback; not used by the Vercel client)
# Security & Secrets
JWT_SECRET=super_secret_gdisc_jwt_key_change_me_in_production_min32chars
SESSION_SECRET=super_secret_gdisc_session_cookie_key_change_in_production

# Database (PostgreSQL or SQLite for quick local zero-config dev)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gdisc?schema=public"

# Legacy Fastify WebRTC settings
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
